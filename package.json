{
  "name": "app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "test": "vitest",
    "test:ui": "vitest run --ui",
    "coverage": "vitest run --coverage",
    "dev": "vite --host",
    "build": "rm -rf build && export NODE_OPTIONS=--max-old-space-size=4096 && vite build --debug",
    "build-w": "rm -rf build && set NODE_OPTIONS=--max-old-space-size=4096 && vite build --debug",
    "preview": "vite preview",
    "version": "auto-changelog --template keepachangelog --hide-credit -p && git add CHANGELOG.md",
    "lint": "eslint --ext .js,.ts,.vue .",
    "lint:fix": "eslint --ext .js,.ts,.vue . --fix",
    "format": "prettier . --write",
    "commit": "git add --all && commit",
    "commit-push": "git add --all && commit && git push origin --all",
    "execute-husky": "npx husky install && npx husky add .husky/pre-commit \"npx --no-install lint-staged\" && npx husky add .husky/commit-msg \"npx --no -- commitlint --config commitlint.config.cjs --edit $1\"",
    "prepare-server": "cd server && composer i && composer dump-autoload",
    "docs:init": "mkdir docs && cd docs && git init && git remote add origin https://github.com/edPage-TG/docs.git && git pull origin master",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:deploy": "pnpm docs:build && gh-pages -d docs/.vitepress/build"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*.{js,ts,vue}": [
      "eslint . --fix",
      "prettier . --write"
    ]
  },
